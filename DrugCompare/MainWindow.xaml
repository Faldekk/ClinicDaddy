<Window x:Class="DrugCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chplNavigator="clr-namespace:DrugCompare.Features.ChPLNavigator"
        xmlns:interactionChecker="clr-namespace:DrugCompare.Features.InteractionChecker"
        xmlns:polishRegistry="clr-namespace:DrugCompare.Features.PolishRegistry"
        xmlns:icdLooker="clr-namespace:DrugCompare.Features.IcdLooker"
        xmlns:evidenceAssistant="clr-namespace:DrugCompare.Features.EvidenceAssistant"
        xmlns:views="clr-namespace:DrugCompare.Views"
        Title="ClinicDaddy"
        Height="900"
        Width="1400"
        MinHeight="700"
        MinWidth="1100"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">

    <Window.Resources>

        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="CornerRadius"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="22"/>
            <Setter Property="Margin"
                    Value="0,0,0,14"/>
        </Style>

        <Style x:Key="MutedTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize"
                    Value="13"/>
        </Style>

        <Style x:Key="NavButtonStyle"
               TargetType="Button" BasedOn="{StaticResource ClinicalButtonStyle}">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="0,2,0,2"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource InkBrush}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="Selector.IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftAccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CollapsedNavButtonStyle"
               TargetType="Button" BasedOn="{StaticResource ClinicalButtonStyle}">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="0,2,0,2"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <Trigger Property="Selector.IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftAccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn"
                              Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="NavigationToggle" Grid.Row="0"
                        Content="☰"
                        ToolTip="Zwiń menu"
                        AutomationProperties.Name="Zwiń menu nawigacyjne"
                        Height="42"
                        Margin="10"
                        FontSize="18"
                        Click="ToggleNavigation_Click"/>

                <!-- Expanded navigation -->
                <ScrollViewer x:Name="ExpandedNavigation"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="18,0,18,0">

                        <TextBlock Text="ClinicDaddy"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Offline Clinical Decision Support"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,20"/>

                        <Expander Header="Narzędzia kliniczne"
          IsExpanded="True"
          Margin="0,0,0,8">
                            <StackPanel Margin="0,8,0,0">

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="Evidence Assistant"
                Tag="0"
                Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="ChPL Navigator"
                Tag="1"
                Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="Interaction Checker"
                Tag="2"
                Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="Polski Rejestr Leków"
                Tag="3"
                Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="ICD Looker"
                Tag="4"
                Click="Navigate_Click"/>

                            </StackPanel>
                        </Expander>

                    

                        <Expander Header="Dane"
                                  IsExpanded="True"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="0,8,0,0">

                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="Zarządzanie danymi"
                                        Tag="5"
                                        Click="Navigate_Click"/>

                            </StackPanel>
                        </Expander>

                        <Expander Header="System"
                                  IsExpanded="False"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="0,8,0,0">

                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="Dziennik operacji"
                                        Tag="6"
                                        Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="Historia"
                                        Tag="7"
                                        Click="Navigate_Click"/>
                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="Ustawienia"
                                        Tag="8"
                                        Click="Navigate_Click"/>

                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- Collapsed navigation -->
                <StackPanel x:Name="CollapsedNavigation"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Margin="8,0,8,0">

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="EA"
        ToolTip="Evidence Assistant"
        Tag="0"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="ChPL"
        ToolTip="ChPL Navigator"
        Tag="1"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="INT"
        ToolTip="Interaction Checker"
        Tag="2"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="R"
        ToolTip="Polski Rejestr Leków"
        Tag="3"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="ICD"
        ToolTip="ICD Looker"
        Tag="4"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="D"
        ToolTip="Zarządzanie danymi"
        Tag="5"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="LOG"
        ToolTip="Dziennik operacji"
        Tag="6"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="H"
        ToolTip="Historia"
        Tag="7"
        Click="Navigate_Click"/>
                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
                            Content="UST" ToolTip="Ustawienia" Tag="8" Click="Navigate_Click"/>

                </StackPanel>

                <TextBlock x:Name="NavigationNotice" Grid.Row="2"
                           Text="Brak danych nie oznacza bezpieczeństwa klinicznego."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="18,14,18,18"/>

            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <TabControl x:Name="MainTabs"
                    SelectionChanged="MainTabs_SelectionChanged"
                    Grid.Column="1"
                    Margin="22"
                    BorderThickness="0"
                    Background="Transparent">

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            
            <!-- 0 Evidence Assistant -->
            <TabItem>
                <evidenceAssistant:EvidenceAssistantView DataContext="{Binding EvidenceAssistant}"/>
            </TabItem>
            <!-- 1 ChPL Navigator -->
            <TabItem>
                <chplNavigator:ChPLNavigatorView DataContext="{Binding ChPLNavigator}"/>
            </TabItem>

            <!-- 2 Interaction Checker -->
            <TabItem>
                <interactionChecker:InteractionCheckerView DataContext="{Binding InteractionChecker}"/>
            </TabItem>

            <!-- 3 Polish Registry -->
            <TabItem>
                <polishRegistry:PolishRegistryView
                    DataContext="{Binding DataContext.PolishDrugRegistry, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </TabItem>

            <!-- 4 ICD Looker -->
            <TabItem>
                <icdLooker:IcdLookerView DataContext="{Binding IcdLooker}"/>
            </TabItem>

            <!-- 5 Data Management -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Knowledge Base Search"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,12">
                                    <Button Content="Szukaj"
                    Command="{Binding SearchKnowledgeBaseCommand}"
                    Height="34"
                    Width="90"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"/>

                                    <TextBox Text="{Binding KnowledgeSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Height="34"
                     VerticalContentAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="{Binding KnowledgeSearchStatus}"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding KnowledgeSearchResults}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  MaxHeight="360">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Source"
                                    Binding="{Binding SourceTitle}"
                                    Width="220"/>

                                        <DataGridTextColumn Header="Section"
                                    Binding="{Binding SectionNumber}"
                                    Width="80"/>

                                        <DataGridTextColumn Header="Status"
                                    Binding="{Binding ReviewStatus}"
                                    Width="120"/>

                                        <DataGridTextColumn Header="Text"
                                    Binding="{Binding ChunkText}"
                                    Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Data Management"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Database Status"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <UniformGrid Columns="3">

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Drugs"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding DrugCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Active substances"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding ActiveSubstanceCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Interactions"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding InteractionCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                </UniformGrid>

                                <Button Content="Odśwież status bazy"
                                        Command="{Binding LoadDatabaseStatusCommand}"
                                        Height="34"
                                        Width="170"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Knowledge Base"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <UniformGrid Columns="3">

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="ChPL documents"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding ChplDocumentCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="ChPL sections"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding ChplSectionCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Knowledge chunks"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding KnowledgeChunkCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                </UniformGrid>

                                <UniformGrid Columns="3"
                                             Margin="0,16,0,0">

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Needs review"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding NeedsReviewChunkCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Reviewed"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding ReviewedChunkCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Verified"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding VerifiedChunkCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                </UniformGrid>

                                <Button Content="Odśwież Knowledge Base"
                                        Command="{Binding LoadKnowledgeBaseStatsCommand}"
                                        Height="34"
                                        Width="190"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Pobieranie dokumentów ChPL"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Pobiera brakujące ChPL z linków zapisanych w polskim rejestrze. Przed importem powstaje kopia bazy. Nowe źródła wymagają weryfikacji."
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <TextBlock Text="Liczba produktów w partii:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding ChplBatchSizes}" SelectedItem="{Binding ChplBatchSize}"
                                              Width="80" Margin="0,0,12,0"/>
                                    <Button Content="Pobierz brakujące ChPL" Command="{Binding ImportChplBatchCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Anuluj" Command="{Binding CancelChplImportCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Ponów błędy" Command="{Binding RetryChplImportCommand}"/>
                                </WrapPanel>
                                <ProgressBar Value="{Binding ChplImportCompleted}" Maximum="{Binding ChplImportTotal}"
                                             Minimum="0" Height="8" Margin="0,12,0,8"
                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource SoftAccentBrush}"/>
                                <TextBlock Text="{Binding ChplImportStatus}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ChplImportBackupPath}" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <DataGrid ItemsSource="{Binding ChplImportFailures}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID produktu" Binding="{Binding ProductId}" Width="100"/>
                                        <DataGridTextColumn Header="Produkt" Binding="{Binding ProductName}" Width="220"/>
                                        <DataGridTextColumn Header="Przyczyna błędu" Binding="{Binding Message}" Width="*" MinWidth="260"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Content="Odśwież Data Management"
                                        Command="{Binding LoadDataManagementCommand}"
                                        Height="34"
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Utwórz kopię bazy"
                                            Command="{Binding CreateDatabaseBackupCommand}"
                                            Height="34" Margin="0,0,8,0"/>
                                    <Button Content="Przywróć kopię bazy"
                                            Command="{Binding RestoreDatabaseBackupCommand}"
                                            Height="34"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6 Audit Log -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Audit Log"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>

                                <Button Content="Odśwież Audit Log"
                                        Command="{Binding LoadAuditLogsCommand}"
                                        Height="34"
                                        Width="160"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding AuditLogs}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time"
                                                            Binding="{Binding CreatedAt}"
                                                            Width="180"/>
                                        <DataGridTextColumn Header="Action"
                                                            Binding="{Binding Action}"
                                                            Width="180"/>
                                        <DataGridTextColumn Header="Details"
                                                            Binding="{Binding Details}"
                                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 7 History -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Interaction History"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>

                                <Button Content="Odśwież historię"
                                        Command="{Binding LoadHistoryCommand}"
                                        Height="34"
                                        Width="150"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding InteractionHistory}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time"
                                                            Binding="{Binding CheckedAt}"
                                                            Width="180"/>
                                        <DataGridTextColumn Header="Substances"
                                                            Binding="{Binding SubstanceNames}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Result"
                                                            Binding="{Binding ResultSummary}"
                                                            Width="260"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <views:SettingsView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
