<UserControl x:Class="DrugCompare.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Dziennik zdarzeń"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Lokalna historia aktywności aplikacji."
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Opacity="0.75"/>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,12,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingAuditLogs}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding AuditLogStatus}" TextWrapping="Wrap"
                           Margin="0,6,12,0" Foreground="{StaticResource MutedBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <Button Content="Odśwież"
                    DockPanel.Dock="Right"
                    Width="120"
                    Height="34"
                    Command="{Binding LoadAuditLogsCommand}"/>
        </DockPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding AuditLogs}"
                  SelectedItem="{Binding SelectedAuditLog, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Czas"
                                    Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                    Width="160"/>

                <DataGridTextColumn Header="Zdarzenie"
                                    Binding="{Binding EventType}"
                                    Width="190"/>

                <DataGridTextColumn Header="Szczegóły"
                                    Binding="{Binding DetailsJson}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4"
                Padding="12"
                CornerRadius="0"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Szczegóły wybranego zdarzenia"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">

                    <TextBox Text="{Binding SelectedAuditLogDetails}"
                             FontFamily="Consolas"
                             FontSize="13"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             AcceptsTab="True"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
