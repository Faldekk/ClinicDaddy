<UserControl x:Class="DrugCompare.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource SurfaceBrush}">

        <StackPanel Margin="24">

            <TextBlock Text="Ustawienia"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}"
                       Margin="0,0,0,4"/>

            <TextBlock Text="Zasady działania ClinicDaddy."
                       FontSize="14"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <Border Background="White"
                    CornerRadius="0"
                    Padding="18"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Tryb aplikacji"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Nazwa aplikacji"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,12,10"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="ClinicDaddy"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Tryb danych"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,12,10"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Local-first / SQLite"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Rola systemu"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,12,0"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="Clinical Decision Support System — informacyjne wsparcie lekarza"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>

                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="0"
                    Padding="18"
                    Margin="0,12,0,0"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Zasady bezpieczeństwa"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Te zasady są stałe i nie powinny być wyłączane przez użytkownika."
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="• System nie podejmuje autonomicznych decyzji klinicznych"
                              TextWrapping="Wrap"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="• Brak danych w bazie nie oznacza bezpieczeństwa"
                              TextWrapping="Wrap"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="• Opisy medyczne powinny być oparte na lokalnych źródłach"
                              TextWrapping="Wrap"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="• Lekarz interpretuje wynik w kontekście pacjenta"
                              TextWrapping="Wrap"
                              Margin="0,0,0,14"/>

                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="0"
                            Padding="12"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="13"
                                   LineHeight="20">
                            <Run Text="ClinicDaddy wspiera lekarza przez szybszy dostęp do uporządkowanych informacji medycznych. "/>
                            <Run Text="System nie zastępuje wiedzy, doświadczenia, aktualnych wytycznych ani decyzji klinicznej lekarza."/>
                        </TextBlock>

                    </Border>

                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="0"
                    Padding="18"
                    Margin="0,12,0,0"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Etap przygotowania MVP"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="• Najpierw spójność interfejsu i nawigacji"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="• Obsługa błędów i stabilność aplikacji"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="• Weryfikacja RAG oraz bazy danych na końcowym etapie"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="• Finalna paczka portable po ukończeniu weryfikacji"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource InkBrush}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
